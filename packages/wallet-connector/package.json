{
  "name": "@multivault/wallet-connector",
  "version": "0.1.6",
  "description": "Unified wallet abstraction layer for MultiVault",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "playground": "vite",
    "debugger": "vite --config vite.debugger.config.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ledgerhq/hw-app-eth": "^6.38.0",
    "@ledgerhq/hw-transport-webhid": "^6.29.0",
    "@ngraveio/bc-ur": "^1.1.13",
    "@walletconnect/ethereum-provider": "^2.11.0",
    "ethers": "^6.11.0",
    "jsqr": "^1.4.0",
    "ledger-bitcoin": "^0.2.3",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "buffer": "^6.0.3",
    "eslint": "^8.56.0",
    "jsdom": "^27.4.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "wallet",
    "ledger",
    "metamask",
    "walletconnect",
    "bitcoin",
    "ethereum",
    "multisig"
  ],
  "author": "MultiVault",
  "license": "MIT"
}
