# Development settings
DEBUG=true
ENVIRONMENT=development

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./data/multivault.db
DATABASE_ECHO=false

# CORS
CORS_ORIGINS=["http://localhost:3001", "http://127.0.0.1:3001", "http://localhost:5173"]

# Bitcoin and EVM network configurations are now stored in database
# Configure networks via API: /api/v1/networks/evm and /api/v1/networks/btc

# Background Workers
SYNC_INTERVAL_SECONDS=60

# Challenge Verification
CHALLENGE_EXPIRY_SECONDS=300
